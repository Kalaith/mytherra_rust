# Local MySQL for the mytherra authority server (GDD 6/8 — the DB is the save).
# Copy this file to `.env` and fill in real credentials. The server assembles a
# MySQL connection from these; the database is created on first run if absent.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mytherra_rust
DB_USER=root
DB_PASSWORD=

# Account linking (GDD 7.3). The shared WebHatchery JWT secret — the SAME value
# every WebHatchery backend uses — so this server can verify the account tokens
# the login issues. Never a per-app secret; never committed with a real value.
JWT_SECRET=replace-with-shared-webhatchery-jwt-secret
# Where the client sends a player to sign in so a guest deity can be linked.
WEBHATCHERY_LOGIN_URL=https://webhatchery.au/login

# Shared secret for the read-only spectator endpoints (`GET /spectate`,
# `GET /spectate/events`), which serve the whole world to a client that owns no
# deity — Tradeborn Realms' world source. Generate a long random value per
# deployment; the server refuses to start without one.
#
# Note: a WebGL client has nowhere secret to keep this, so a published browser
# build ships the token inside its .wasm and anyone who downloads it can read
# the unfiltered world. That is acceptable for a read-only projection of a world
# no spectator can alter, but it is not a credential to reuse anywhere else.
SPECTATOR_TOKEN=replace-with-a-long-random-spectator-secret
